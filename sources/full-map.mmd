            SC_SF -->|"Flotation tailings"| SC_BT

            SC_MX -.->|"Route according to mineralogy"| SC_OXC
            SC_MX -.->|"Route according to mineralogy"| SC_SC
        end

        subgraph SC_T3["TIER 3 — METALLURGICAL EXTRACTION AND INTERMEDIATE PRODUCTION"]
            direction TB

            SC_SCON -->|"Concentrate to roasting"| SC_RO["Sulfating roasting"]
            SC_RO -->|"Roasted Cu-Co calcine"| SC_QU["Quenching and repulping"]
            SC_QU -->|"Calcine slurry"| SC_LEACH["Acid leaching"]

            SC_OXS -->|"Whole-ore slurry"| SC_LEACH
            SC_OXCS -->|"Concentrate slurry"| SC_LEACH
