            SC_COP -->|"Cobalt hydroxide slurry"| SC_COF["Thickening, filtration and washing"]
            SC_COF -->|"Cobalt hydroxide cake"| SC_COH["COBALT HYDROXIDE"]

            SC_COF -->|"Mother liquor"| SC_SCAV["Secondary cobalt precipitation / scavenging"]
            SC_SCAV -.->|"Recovered Co-bearing solids"| SC_FAM
            SC_SCAV -->|"Co-depleted liquor"| SC_WW["Water treatment / CCD recycle"]

            SC_SCON -->|"Concentrate to smelting"| SC_SM["Smelting and converting"]
            SC_SM -->|"Copper-rich blister metal"| SC_BCU["Anode refining and casting"]
            SC_BCU -->|"Copper anodes"| SC_CUER["Copper electrorefining"]
            SC_CUER -->|"Copper cathodes"| SC_CATH

            SC_SM -->|"Cobalt-bearing slag"| SC_SLAG["Cobalt-rich smelter slag"]
            SC_SLAG -->|"Slag feed"| SC_REDUCT["Carbothermic reduction in electric furnace"]
            SC_CAR["Carbonaceous reductant"] --> SC_REDUCT

            SC_REDUCT -->|"Metal and slag phases"| SC_SEP["Metal-slag separation"]
            SC_SEP -->|"Discard / depleted slag"| SC_SR["Slag management"]
            SC_SEP -->|"Recovered alloy"| SC_ALLOY["Co-Cu-Fe ALLOY"]
        end
    end

