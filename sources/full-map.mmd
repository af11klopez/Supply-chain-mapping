    subgraph LA_MAP["TIERS 1–3 — Ni-Co LATERITE DEPOSITS"]
        direction TB

        subgraph LA_T1["TIER 1 — MINING AND ORE EXTRACTION"]
            direction TB

            LA_DEP["Ni-Co laterite deposit"]
            LA_DEP --> LA_MIN["Selective open-pit mining"]
            LA_MIN -->|"Excavated lateritic ore"| LA_ROM["ROM handling and stockpiling"]
            LA_MIN -->|"Overburden and barren rock"| LA_W1["Waste rock management"]

            LA_ROM --> LA_GC["Ore classification and blending"]

            LA_GC -->|"Oxide-rich ore"| LA_LIM["Limonite ore"]
            LA_GC -->|"Clay-rich transition ore"| LA_CLAY["Smectite / transition ore"]
            LA_GC -->|"Mg-silicate-rich ore"| LA_SAP["Saprolite ore"]
        end

        subgraph LA_T2["TIER 2 — ORE PREPARATION AND BENEFICIATION"]
            direction TB

            LA_LIM --> LA_LC["Crushing and wet scrubbing"]
            LA_CLAY --> LA_LC
            LA_LC -->|"Disaggregated ore slurry"| LA_LS["Screening and hydraulic classification"]
            LA_LS -->|"Coarse barren material"| LA_R1["Coarse rejects"]
            LA_LS -->|"Ni-Co-bearing fine slurry"| LA_LT["Thickening and blending"]
            LA_LT -->|"Conditioned limonite / clay slurry"| LA_HPF["Prepared HPAL feed"]

            LA_SAP --> LA_SC["Crushing and screening"]
            LA_SC -->|"Sized saprolite"| LA_SS["Scrubbing and classification"]
            LA_SS -->|"Barren coarse fraction"| LA_R2["Coarse rejects"]
            LA_SS -->|"Beneficiated saprolite slurry"| LA_ST["Thickening"]
            LA_ST -->|"Saprolite slurry"| LA_ALF["Prepared atmospheric-leach feed"]

            LA_SC -->|"Selected saprolite"| LA_DR["Drying and screening"]
            LA_DR -->|"Dry saprolite ore"| LA_PYF["Prepared smelter feed"]

            LA_LC -.->|"Suitable oxide ore"| LA_CD["Dewatering and drying"]
            LA_CD -->|"Dry ore"| LA_CF["Prepared Caron feed"]

            LA_SC -.->|"Suitable low-grade leachable ore"| LA_AG["Sizing and agglomeration"]
            LA_AG -->|"Agglomerated ore"| LA_HLF["Prepared heap-leach feed"]
        end

        subgraph LA_T3["TIER 3 — METALLURGICAL EXTRACTION AND INTERMEDIATE PRODUCTION"]
            direction TB

            %% HPAL route
            LA_HPF --> LA_PH["Preheating and slurry pressurisation"]
            LA_PH -->|"Heated ore slurry"| LA_HPAL["High-pressure acid leaching"]
            LA_H2["Sulfuric acid and steam"] --> LA_HPAL
            LA_HPAL -->|"Ni-Co-bearing leach slurry"| LA_FL["Flash depressurisation and heat recovery"]

            %% Atmospheric leach route
            LA_ALF --> LA_PRE["Atmospheric acid pre-leaching"]
            LA_AS["Sulfuric acid"] --> LA_PRE
            LA_PRE -->|"Partially leached saprolite slurry"| LA_AL["Atmospheric leaching"]
            LA_FL -.->|"HPAL discharge - combined circuit"| LA_AL

            %% Neutralisation / CCD route
            LA_FL -->|"HPAL discharge - standalone circuit"| LA_PN["Partial neutralisation"]
            LA_AL -->|"Ni-Co-bearing leach slurry"| LA_PN
            LA_LST["Limestone"] --> LA_PN
            LA_PN -->|"Partially neutralised slurry"| LA_CCD["Counter-current decantation and washing"]
            LA_CCD -->|"Washed leach residue"| LA_TAIL["Tailings neutralisation and management"]
            LA_CCD -->|"Ni-Co-rich pregnant leach solution"| LA_IMP["Fe / Al / Cr impurity precipitation"]
            LA_IMP -->|"Impurity-bearing slurry"| LA_IF["Thickening and filtration"]
            LA_IF -->|"Impurity solids"| LA_TAIL
            LA_IF -->|"Clarified Ni-Co sulfate liquor"| LA_SOL["Ni-Co sulfate solution hub"]

            %% Heap leach route
            LA_HLF --> LA_HEAP["Sulfuric acid heap leaching"]
            LA_HEAP -->|"Ni-Co pregnant leach solution"| LA_HCL["Solution clarification"]
            LA_HCL -->|"Clarified Ni-Co liquor"| LA_IMP

            %% MHP route
            LA_SOL -->|"Solution to hydroxide route"| LA_MHP1["Mixed hydroxide precipitation"]
            LA_MGO["MgO / NaOH"] --> LA_MHP1
            LA_MHP1 -->|"Ni-Co hydroxide slurry"| LA_MHP2["Thickening, filtration and washing"]
            LA_MHP2 -->|"Mixed hydroxide filter cake"| LA_MHPO["MHP - MIXED HYDROXIDE PRECIPITATE"]
            LA_MHP2 -->|"Ni-Co-bearing mother liquor"| LA_SCAV["Scavenger precipitation"]
            LA_SCAV -->|"Recovered Ni-Co solids"| LA_IMP
            LA_SCAV -->|"Depleted liquor"| LA_WW["Effluent treatment / water recycle"]

            %% MSP route
            LA_SOL -->|"Solution to sulfide route"| LA_MSP1["Mixed sulfide precipitation"]
            LA_HS["Hydrogen sulfide"] --> LA_MSP1
            LA_MSP1 -->|"Ni-Co sulfide slurry"| LA_MSP2["Thickening, filtration and washing"]
            LA_MSP2 -->|"Mixed sulfide filter cake"| LA_MSPO["MSP - MIXED SULFIDE PRECIPITATE"]
            LA_MSP2 -->|"Depleted liquor"| LA_WW

            %% Direct eluate route
            LA_FL -.->|"Leached slurry to resin circuit"| LA_RIP["Resin-in-pulp adsorption"]
            LA_RIP -->|"Loaded Ni-Co resin"| LA_EL["Acid elution"]
            LA_EL -->|"Ni-Co-rich sulfate eluate"| LA_ELU["Ni-Co-RICH SULFATE ELUATE"]
            LA_RIP -->|"Barren slurry"| LA_TAIL

            %% Purified solution route
            LA_SOL -->|"Solution to direct recovery"| LA_SX["Impurity removal by SX / IX"]
            LA_SX -->|"Separated impurity stream"| LA_IW["Impurity treatment"]
            LA_SX -->|"Purified Ni-Co-bearing solution"| LA_PURE["PURIFIED Ni-Co-BEARING SOLUTION"]

            %% Goro-type route
            LA_SOL -.->|"Goro-type recovery option"| LA_GSX["Primary Ni-Co solvent extraction"]
            LA_GSX -->|"Recovered Ni-Co stream"| LA_ZN["Zinc removal"]
            LA_ZN -->|"Purified Ni-Co stream"| LA_SEP["Ni-Co separation by solvent extraction"]
            LA_SEP -->|"Co-rich solution"| LA_COCP["Cobalt carbonate precipitation"]
            LA_NC["Sodium carbonate"] --> LA_COCP
            LA_COCP -->|"Cobalt carbonate filter cake"| LA_CCO["COBALT CARBONATE"]
            LA_SEP -->|"Ni-rich solution"| LA_NIOP["Nickel pyrohydrolysis"]
            LA_NIOP -->|"Nickel oxide granules"| LA_NIO["NICKEL OXIDE"]

            %% Pyromet route
            LA_PYF --> LA_RKEF["Rotary kiln drying and reduction"]
            LA_RD["Reducing agent"] --> LA_RKEF
            LA_RKEF -->|"Reduced hot calcine"| LA_EF["Electric furnace smelting"]
            LA_EF -->|"Ferronickel metal"| LA_FENI["FERRONICKEL / NPI"]
            LA_EF -->|"Smelting slag"| LA_SLG["Slag management"]

            %% Caron route
            LA_CF --> LA_CR["Reduction roasting"]
            LA_CR -->|"Reduced roasted ore"| LA_AM["Ammonia-ammonium carbonate leaching"]
            LA_AM -->|"Ammoniacal leach slurry"| LA_ASL["Solid-liquid separation"]
            LA_ASL -->|"Leach residue"| LA_TAIL
            LA_ASL -->|"Ni-Co-bearing ammoniacal liquor"| LA_CAR["Ammonia stripping and metal recovery"]
            LA_CAR -->|"Nickel product"| LA_CNI["NICKEL OXIDE / CARBONATE"]
            LA_CAR -.->|"Cobalt by-product - process dependent"| LA_CCO2["Cobalt-bearing intermediate"]
        end
    end

