            SC_RED["SO2 / reductant as required"] --> SC_LEACH

            SC_LEACH -->|"Cu-Co leach slurry"| SC_SL["Thickening and counter-current decantation"]
            SC_SL -->|"Washed leach residue"| SC_RT["Residue neutralisation and tailings"]
            SC_SL -->|"Cu-Co pregnant leach solution"| SC_PLS["Clarification and solution conditioning"]

            SC_PLS -->|"Clarified Cu-Co liquor"| SC_CUSX["Copper solvent extraction"]

            SC_CUSX -->|"Copper-loaded organic"| SC_CUSTR["Copper stripping"]
            SC_CUSTR -->|"Cu-rich electrolyte"| SC_CUFIL["Electrolyte filtration"]
            SC_CUFIL -->|"Clean copper electrolyte"| SC_CUEW["Copper electrowinning"]
            SC_CUEW -->|"Copper cathodes"| SC_CATH["COPPER CATHODE"]

            SC_CUEW -.->|"Spent electrolyte"| SC_CUSTR
            SC_CUSTR -.->|"Regenerated organic"| SC_CUSX

            SC_CUSX -->|"Copper-depleted raffinate"| SC_RS["Raffinate split"]
            SC_RS -.->|"Raffinate recycle"| SC_LEACH

            SC_RS -->|"Cobalt-bearing bleed"| SC_FAM["Fe / Al / Mn precipitation"]
