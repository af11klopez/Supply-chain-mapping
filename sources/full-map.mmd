            SC_CUCL -->|"Copper-containing slurry"| SC_CUSEP["Solid-liquid separation"]
            SC_CUSEP -->|"Copper-bearing precipitate"| SC_LEACH

            SC_CUSEP -->|"Purified cobalt-bearing liquor"| SC_COP["Cobalt hydroxide precipitation"]
